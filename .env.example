# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modelo de transcrição a ser usado (whisper-1 ou gpt-4o-transcribe)
TRANSCRIPTION_MODEL=whisper-1

# Idioma dos áudios, no formato ISO-639-1 (ex: pt, en, es). Deixe em branco para detecção automática.
TRANSCRIPTION_LANGUAGE=pt

# Se "true", o bot só transcreve áudios enviados por você mesmo (fromMe).
# Se "false", transcreve áudios de qualquer conversa/contato.
# Esses três valores acima são só os defaults iniciais: depois do primeiro start,
# eles passam a ser editáveis pelo painel admin (data/settings.json) e este .env
# não é mais consultado para eles.
ONLY_TRANSCRIBE_OWN_AUDIOS=false

# --- Painel admin (interface web) ---
# Usuário, hash da senha e segredo de sessão são gerados automaticamente no
# primeiro start e gravados em data/admin-credentials.json (não neste .env —
# um hash bcrypt tem "$" no formato $2a$10$..., e o Docker Compose interpola
# "$" ao carregar env_file, corrompendo qualquer hash guardado aqui).
# A senha gerada aparece UMA VEZ no log do container; troque-a pelo painel depois.

# Porta em que o painel admin escuta dentro do container. Nenhuma porta do
# host é publicada (ver docker-compose.yml) — o painel só é alcançável pelo
# reverse proxy (Caddy) compartilhado da VPS, via rede interna do Docker.
ADMIN_PORT=3000

# Defina como "true" quando o painel estiver atrás do reverse proxy HTTPS
# (ele passa a exigir cookies "secure" e a confiar no header X-Forwarded-*).
TRUST_PROXY=true
