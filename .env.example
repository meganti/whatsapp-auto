# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modelo de transcrição a ser usado (whisper-1 ou gpt-4o-transcribe)
TRANSCRIPTION_MODEL=whisper-1

# Idioma dos áudios, no formato ISO-639-1 (ex: pt, en, es). Deixe em branco para detecção automática.
TRANSCRIPTION_LANGUAGE=pt

# Se "true", o bot só transcreve áudios enviados por você mesmo (fromMe).
# Se "false", transcreve áudios de qualquer conversa/contato.
ONLY_TRANSCRIBE_OWN_AUDIOS=false

# Porta da interface web (status da conexão, QR code e histórico de transcrições)
WEB_PORT=3000

# Usuário e senha para proteger a interface web com HTTP Basic Auth.
# Se deixar em branco, a interface fica acessível sem autenticação — não recomendado
# se a porta estiver exposta publicamente (ex: numa VPS).
WEB_USERNAME=
WEB_PASSWORD=
